"""Shared, compute-matched Flat SFT and DUCL LoRA trainer."""
from __future__ import annotations

import argparse
import json
import math
from pathlib import Path

import torch
from datasets import Dataset
from peft import LoraConfig
from torch.utils.data import Sampler
from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig
from trl import SFTConfig, SFTTrainer

from .common import load_jsonl, prompt_text, set_seed
from .scoring_v2 import window_order_from_due

BASE_DEFAULT = "/root/autodl-tmp/mBT/model/llama32-1b"


class EpochOrderSampler(Sampler[int]):
    """Deterministic sampler whose iterator advances one training epoch."""

    def __init__(self, n: int, mode: str, seed: int, batch_size: int,
                 due_values: list[float] | None = None, alpha: float = 0.5):
        self.n, self.mode, self.seed = n, mode, seed
        self.batch_size, self.due_values, self.alpha = batch_size, due_values, alpha
        self.epoch = 0
        self.orders: list[list[int]] = []

    def __iter__(self):
        if self.mode == "ducl":
            if self.due_values is None or len(self.due_values) != self.n:
                raise RuntimeError("DUCL dataset is missing bt_due values")
            order = window_order_from_due(
                self.due_values, self.batch_size, self.alpha, self.seed + self.epoch,
            )
        else:
            generator = torch.Generator()
            generator.manual_seed(self.seed + self.epoch)
            order = torch.randperm(self.n, generator=generator).tolist()
        self.orders.append(order)
        self.epoch += 1
        return iter(order)

    def __len__(self):
        return self.n


class MatchedSFTTrainer(SFTTrainer):
    def __init__(self, *args, sampler_mode: str, sampler_seed: int,
                 sampler_batch_size: int, sampler_alpha: float,
                 sampler_due_values: list[float] | None, **kwargs):
        self.sampler_mode = sampler_mode
        self.sampler_seed = sampler_seed
        self.sampler_batch_size = sampler_batch_size
        self.sampler_alpha = sampler_alpha
        self.sampler_due_values = sampler_due_values
        super().__init__(*args, **kwargs)
        self._epoch_sampler: EpochOrderSampler | None = None

    def _get_train_sampler(self, train_dataset=None):
        dataset = train_dataset if train_dataset is not None else self.train_dataset
        if dataset is None:
            return None
        if self._epoch_sampler is None:
            due_values = None
            if self.sampler_mode == "ducl" and "bt_due" in dataset.column_names:
                due_values = [float(value) for value in dataset["bt_due"]]
            self._epoch_sampler = EpochOrderSampler(
                len(dataset), self.sampler_mode, self.sampler_seed,
                self.sampler_batch_size, due_values, self.sampler_alpha,
            )
        return self._epoch_sampler


def _rows_to_dataset(rows: list[dict], tokenizer) -> Dataset:
    out = []
    for row in rows:
        out.append({"prompt": prompt_text(row, tokenizer),
                    "completion": row["output"] + tokenizer.eos_token})
    return Dataset.from_list(out)


def _load_model(base: str, lora_r: int, lora_alpha: int):
    bnb = BitsAndBytesConfig(
        load_in_4bit=True, bnb_4bit_quant_type="nf4",
        bnb_4bit_compute_dtype=torch.bfloat16,
    )
    tok = AutoTokenizer.from_pretrained(base)
    if tok.pad_token is None:
        tok.pad_token = tok.eos_token
    tok.padding_side = "right"
    model = AutoModelForCausalLM.from_pretrained(
        base, quantization_config=bnb, device_map="auto",
        torch_dtype=torch.bfloat16,
    )
    peft = LoraConfig(
        r=lora_r, lora_alpha=lora_alpha, lora_dropout=0.05,
        bias="none", task_type="CAUSAL_LM",
        target_modules=["q_proj", "k_proj", "v_proj", "o_proj",
                        "gate_proj", "up_proj", "down_proj"],
    )
    return model, tok, peft


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", choices=("flat", "ducl"), required=True)
    ap.add_argument("--train", required=True)
    ap.add_argument("--ordered", default=None)
    ap.add_argument("--val", required=True)
    ap.add_argument("--base", default=BASE_DEFAULT)
    ap.add_argument("--run-dir", required=True)
    ap.add_argument("--epochs", type=int, default=3)
    ap.add_argument("--batch", type=int, default=4)
    ap.add_argument("--accum", type=int, default=4)
    ap.add_argument("--lr", type=float, default=1e-4)
    ap.add_argument("--max-len", type=int, default=2560)
    ap.add_argument("--lora-r", type=int, default=16)
    ap.add_argument("--lora-alpha", type=int, default=32)
    ap.add_argument("--seed", type=int, default=42)
    ap.add_argument("--limit", type=int, default=0)
    args = ap.parse_args()
    if args.mode == "ducl" and not args.ordered:
        raise ValueError("DUCL requires --ordered produced by scoring")
    set_seed(args.seed)

    train_rows = load_jsonl(args.ordered if args.mode == "ducl" else args.train)
    val_rows = load_jsonl(args.val)
    if args.limit:
        train_rows, val_rows = train_rows[:args.limit], val_rows[:max(1, args.limit // 10)]
    model, tokenizer, peft = _load_model(args.base, args.lora_r, args.lora_alpha)
    train_ds = _rows_to_dataset(train_rows, tokenizer)
    val_ds = _rows_to_dataset(val_rows, tokenizer)
    updates_per_epoch = math.ceil(len(train_rows) / (args.batch * args.accum))
    total_updates = updates_per_epoch * args.epochs

    out_dir = Path(args.run_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    cfg = SFTConfig(
        output_dir=str(out_dir), num_train_epochs=args.epochs,
        per_device_train_batch_size=args.batch,
        gradient_accumulation_steps=args.accum,
        per_device_eval_batch_size=args.batch,
        learning_rate=args.lr, lr_scheduler_type="linear", warmup_ratio=0.1,
        optim="paged_adamw_32bit", bf16=True,
        logging_steps=25, eval_strategy="epoch", save_strategy="no",
        max_length=args.max_len, completion_only_loss=True,
        loss_type="nll",
        seed=args.seed, data_seed=args.seed, report_to=[],
    )
    trainer = MatchedSFTTrainer(
        model=model, args=cfg, train_dataset=train_ds, eval_dataset=val_ds,
        peft_config=peft, processing_class=tokenizer,
        sampler_mode=args.mode, sampler_seed=args.seed,
        sampler_batch_size=args.batch, sampler_alpha=0.5,
    )
    train_result = trainer.train()
    eval_metrics = trainer.evaluate()
    trainer.save_model(str(out_dir))
    if trainer._epoch_sampler is None or trainer._epoch_sampler.epoch != args.epochs:
        raise RuntimeError("sampler did not produce exactly one order per epoch")
    order_hashes = []
    import hashlib
    for order in trainer._epoch_sampler.orders:
        order_hashes.append(hashlib.sha256(
            ",".join(map(str, order)).encode("ascii")).hexdigest())
    metadata = {
        "mode": args.mode, "seed": args.seed, "n_train": len(train_rows),
        "n_val": len(val_rows), "epochs": args.epochs,
        "per_device_batch": args.batch, "gradient_accumulation": args.accum,
        "updates_per_epoch": updates_per_epoch, "total_optimizer_updates": total_updates,
        "learning_rate": args.lr, "max_len": args.max_len,
        "loss_type": "nll",
        "sampler_window": "official_DUCL_window_quantile_10_to_100_percent_per_epoch",
        "sampler_alpha": 0.5,
        "train_loss": train_result.training_loss,
        "train_runtime": train_result.metrics.get("train_runtime"),
        "eval": eval_metrics, "sampler_order_hashes": order_hashes,
    }
    (out_dir / "train_metadata.json").write_text(json.dumps(metadata, indent=2), encoding="utf-8")
    print(json.dumps(metadata, indent=2))


if __name__ == "__main__":
    main()
