<root BTCPP_format="4" main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <Parallel success_threshold="2" failure_threshold="1">
            <SubTree ID="Agent_alpha"/>
            <SubTree ID="Agent_beta"/>
        </Parallel>
    </BehaviorTree>
    <BehaviorTree ID="Agent_alpha">
        <Sequence>
            <Fallback>
                <MoveTo robot="alpha" from="charge_bay" to="shelf_a"/>
                <Sequence>
                    <Recharge robot="alpha" station="charge_bay"/>
                    <MoveTo robot="alpha" from="charge_bay" to="shelf_a"/>
                </Sequence>
            </Fallback>
            <Sequence>
                <IsAtLocation robot="alpha" location="shelf_a"/>
                <IsItemAt item="box_small" location="shelf_a"/>
                <PickUp robot="alpha" item="box_small" location="shelf_a"/>
            </Sequence>
            <Fallback>
                <MoveTo robot="alpha" from="shelf_a" to="charge_bay"/>
                <Sequence>
                    <MoveTo robot="alpha" from="shelf_a" to="charge_bay"/>
                    <Recharge robot="alpha" station="charge_bay"/>
                    <MoveTo robot="alpha" from="charge_bay" to="shelf_a"/>
                    <MoveTo robot="alpha" from="shelf_a" to="charge_bay"/>
                </Sequence>
            </Fallback>
            <Sequence>
                <IsAtLocation robot="alpha" location="charge_bay"/>
                <SignalReady robot="alpha" item="box_small" to="beta"/>
                <HandoverGive giver="alpha" receiver="beta" item="box_small" location="charge_bay"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
    <BehaviorTree ID="Agent_beta">
        <Sequence>
            <Sequence>
                <WaitReady robot="beta" item="box_small" from="alpha"/>
                <HandoverTake receiver="beta" giver="alpha" item="box_small" location="charge_bay"/>
            </Sequence>
            <MoveTo robot="beta" from="charge_bay" to="loading_dock"/>
            <Sequence>
                <IsCarrying robot="beta" item="box_small"/>
                <PlaceDown robot="beta" item="box_small" location="loading_dock"/>
            </Sequence>
        </Sequence>
    </BehaviorTree>
</root>